# Copy values into your shell environment or an ignored .env.local file.
# Never commit real passwords or API keys.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=neighbor_market
DB_USERNAME=neighbor_app
DB_PASSWORD=replace_locally
DB_USE_SSL=false
APP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Docker Compose local deployment. Copy this file to ignored .env and replace
# every placeholder. APP_ORIGIN must match the browser-visible origin.
APP_PORT=8088
APP_ORIGIN=http://localhost:8088


SERVER_ADDRESS=127.0.0.1
SESSION_COOKIE_SECURE=false

# Demo users are created only when SPRING_PROFILES_ACTIVE=demo.
# Compose fixes the backend to prod and ignores these blank demo settings.
SPRING_PROFILES_ACTIVE=
DEMO_USER_A_PASSWORD=
DEMO_USER_B_PASSWORD=

# AI pricing is optional. Leave all four values blank when unused.
# Configure only in a local ignored file or deployment secret store.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_PROVIDER=

# Production requires DB_HOST, DB_NAME, DB_USERNAME, DB_PASSWORD and
# APP_ALLOWED_ORIGINS. Do not enable the demo profile in production.
# SESSION_COOKIE_SECURE must remain true behind HTTPS.
